{
  "name": "@lumi-icons/core",
  "version": "0.1.0",
  "description": "Animated, lightweight 3D icons as a framework-independent Web Component.",
  "keywords": [
    "icons",
    "3d-icons",
    "web-components",
    "custom-elements",
    "svg",
    "animated-icons"
  ],
  "license": "MIT",
  "author": "whoispasindu",
  "homepage": "https://github.com/whoispasindu/Lumi-Icons#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/whoispasindu/Lumi-Icons.git"
  },
  "bugs": "https://github.com/whoispasindu/Lumi-Icons/issues",
  "packageManager": "pnpm@12.8.1",
  "type": "module",
  "main": "./dist/core/index.js",
  "module": "./dist/core/index.js",
  "types": "./dist/core/index.d.ts",
  "files": [
    "dist/core",
    "element",
    "icons",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "./dist/core/index.js",
    "./dist/core/all.js",
    "./dist/core/element.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/core/index.d.ts",
      "default": "./dist/core/index.js"
    },
    "./element": {
      "types": "./dist/core/element.d.ts",
      "default": "./dist/core/element.js"
    },
    "./icons": {
      "types": "./dist/core/catalog.d.ts",
      "default": "./dist/core/catalog.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "build:core": "tsc -p tsconfig.build.json",
    "build": "pnpm run check && pnpm run build:core && vite build",
    "build:wrappers": "pnpm --filter @lumi-icons/react --filter @lumi-icons/vue --filter @lumi-icons/angular --filter @lumi-icons/react-native run build",
    "preview": "vite preview",
    "prepublishOnly": "pnpm run check && pnpm run test && pnpm run build:core",
    "test:angular": "pnpm --filter @lumi-icons/angular test",
    "test:dist": "vitest run --config vitest.dist.config.ts"
  },
  "devDependencies": {
    "happy-dom": "^20.14.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.2"
  }
}
